RawStory = "{\"inkVersion\":21,\"root\":[[\"\\n\",[\"done\",{\"#f\":5,\"#n\":\"g-0\"}],null],\"done\",{\"init\":[[\"#\",\"^SET_SPRITEBACKGROUND:scene_main \",\"/#\",\"#\",\"^SET_SPRITESUBTEXTURE:city\",\"/#\",\"^The year is 20XX. \",\"ev\",\"str\",\"^box_1\",\"/str\",2,5,{\"f()\":\"B\"},\"out\",\"/ev\",\"^ \",\"#\",\"^PLAY_MUSIC:MusicCalm\",\"/#\",\"\\n\",\"^The [b]War[/b] between [b]Machines[/b] and [b]Men[/b] is[br]in the distant past... \",\"ev\",\"str\",\"^box_2\",\"/str\",3,1,{\"f()\":\"B\"},\"out\",\"/ev\",\"\\n\",\"^And as the [b]clouds of radiation[/b] have finally[br]started dissipating from the blasted cities... \",\"ev\",\"str\",\"^box_3\",\"/str\",2,1,{\"f()\":\"B\"},\"out\",\"/ev\",\"\\n\",\"^[b]Scavengers[/b] - like you - have begun[br]to loot the [b]OldTek[/b] hidden in the ruins. \",\"ev\",\"str\",\"^box_4\",\"/str\",3,1,{\"f()\":\"B\"},\"out\",\"/ev\",\"\\n\",\"^There is just one problem. \",\"#\",\"^clear\",\"/#\",\"\\n\",\"^Sooo the ruin's full of robots.. \",\"ev\",{\"VAR?\":\"Deya\"},{\"VAR?\":\"Neutral2\"},{\"f()\":\"S\"},\"out\",\"/ev\",\"\\n\",\"^So? Just don't get seen. \",\"ev\",{\"VAR?\":\"Zayne\"},{\"VAR?\":\"Neutral1\"},{\"f()\":\"S\"},\"out\",\"/ev\",\"\\n\",\"^That's easy for you to say! \",\"ev\",{\"VAR?\":\"Deya\"},{\"VAR?\":\"Angry\"},{\"f()\":\"S\"},\"out\",\"/ev\",\"\\n\",\"^You're not the one going in there! \",\"ev\",{\"VAR?\":\"Deya\"},{\"VAR?\":\"Angry\"},{\"f()\":\"S\"},\"out\",\"/ev\",\"\\n\",\"^Relaaax. You're faster than they are. Just don't get stuck in a corner with one. \",\"ev\",{\"VAR?\":\"Zayne\"},{\"VAR?\":\"Smile1\"},{\"f()\":\"S\"},\"out\",\"/ev\",\"\\n\",\"^Besides, they forget about you the moment they lose sight of you. So just hide. \",\"ev\",{\"VAR?\":\"Zayne\"},{\"VAR?\":\"Smirk1\"},{\"f()\":\"S\"},\"out\",\"/ev\",\"\\n\",\"^Ugh. What are we looking for anyway? \",\"ev\",{\"VAR?\":\"Deya\"},{\"VAR?\":\"Neutral1\"},{\"f()\":\"S\"},\"out\",\"/ev\",\"\\n\",\"^The old man gave us a list, but...I dunno what half of these things are. \",\"ev\",{\"VAR?\":\"Zayne\"},{\"VAR?\":\"Sad\"},{\"f()\":\"S\"},\"out\",\"/ev\",\"\\n\",\"^Let me see that. \",\"ev\",{\"VAR?\":\"Deya\"},{\"VAR?\":\"Angry\"},{\"f()\":\"S\"},\"out\",\"/ev\",\"\\n\",\"^...well. Shit. OldTek indeed. \",\"ev\",{\"VAR?\":\"Deya\"},{\"VAR?\":\"Sad\"},{\"f()\":\"S\"},\"out\",\"/ev\",\"\\n\",\"^Let's just start looking. We'll make an educated guess once we have something. \",\"ev\",{\"VAR?\":\"Zayne\"},{\"VAR?\":\"Smirk2\"},{\"f()\":\"S\"},\"out\",\"/ev\",\"\\n\",\"^Fine. But you better pull your weight! \",\"ev\",{\"VAR?\":\"Deya\"},{\"VAR?\":\"Smirk1\"},{\"f()\":\"S\"},\"out\",\"/ev\",\"\\n\",\"ev\",{\"f()\":\"ClearPortraits\"},\"out\",\"/ev\",\"\\n\",\"ev\",\"str\",\"^Start over\",\"/str\",\"/ev\",{\"*\":\".^.c-0\",\"flg\":4},\"ev\",\"str\",\"^Play some music\",\"/str\",{\"VAR?\":\"isPlaying\"},\"!\",\"/ev\",{\"*\":\".^.c-1\",\"flg\":5},\"ev\",\"str\",\"^Stop music\",\"/str\",{\"VAR?\":\"isPlaying\"},\"/ev\",{\"*\":\".^.c-2\",\"flg\":5},\"ev\",\"str\",\"^Start Ambience\",\"/str\",\"/ev\",{\"*\":\".^.c-3\",\"flg\":4},\"ev\",\"str\",\"^Stop Ambience\",\"/str\",\"/ev\",{\"*\":\".^.c-4\",\"flg\":4},\"ev\",\"str\",\"^Load level\",\"/str\",\"/ev\",{\"*\":\".^.c-5\",\"flg\":4},{\"c-0\":[\"\\n\",{\"->\":\"init\"},{\"#f\":5}],\"c-1\":[\"\\n\",\"^Let's play some music. \",\"#\",\"^PLAY_MUSIC:MusicCalm\",\"/#\",\"\\n\",\"ev\",true,\"/ev\",{\"VAR=\":\"isPlaying\",\"re\":true},{\"->\":\"init\"},{\"#f\":5}],\"c-2\":[\"\\n\",\"^All right, enough. \",\"#\",\"^PLAY_MUSIC:None\",\"/#\",\"\\n\",\"ev\",false,\"/ev\",{\"VAR=\":\"isPlaying\",\"re\":true},{\"->\":\"init\"},{\"#f\":5}],\"c-3\":[\"\\n\",\"#\",\"^PLAY_AMBIENCE:AmbienceWind\",\"/#\",\"^Wind wind!\",\"\\n\",{\"->\":\"init\"},{\"#f\":5}],\"c-4\":[\"\\n\",\"#\",\"^PLAY_AMBIENCE:None\",\"/#\",\"^No wind.\",\"\\n\",{\"->\":\"init\"},{\"#f\":5}],\"c-5\":[\"\\n\",\"^Loading level 1. \",\"#\",\"^LOAD_LEVEL:level_1 \",\"/#\",\"#\",\"^clear \",\"/#\",\"#\",\"^PLAY_MUSIC:MusicCombat\",\"/#\",\"\\n\",\"done\",{\"#f\":5}]}],{\"#f\":1}],\"continuePlay\":[[\"^And we're back!\",\"\\n\",\"^Hooray!\",\"\\n\",\"ev\",\"str\",\"^Back to start\",\"/str\",\"/ev\",{\"*\":\".^.c-0\",\"flg\":4},{\"c-0\":[\"\\n\",{\"->\":\"init\"},{\"#f\":5}]}],{\"#f\":1}],\"story_knot_test\":[[\"^This is a story knot! WooooOOoo! \",\"#\",\"^SET_CAMERA_TARGET:Default^1^0 \",\"/#\",\"#\",\"^SET_SPRITESUBTEXTURE:ruin\",\"/#\",\"\\n\",\"ev\",\"str\",\"^Rock on.\",\"/str\",\"/ev\",{\"*\":\".^.c-0\",\"flg\":4},\"ev\",\"str\",\"^WOOOO\",\"/str\",\"/ev\",{\"*\":\".^.c-1\",\"flg\":4},{\"c-0\":[\"\\n\",\"^We rock on.\",\"\\n\",{\"->\":\".^.^.g-0\"},{\"#f\":5}],\"c-1\":[\"\\n\",\"^Woo. \",\"#\",\"^continue\",\"/#\",\"\\n\",{\"->\":\".^.^.g-0\"},{\"#f\":5}],\"g-0\":[\"#\",\"^UNPAUSE_LEVEL \",\"/#\",\"#\",\"^continue \",\"/#\",\"#\",\"^SET_SPRITESUBTEXTURE:ruin^false\",\"/#\",\"done\",{\"#f\":5}]}],{\"#f\":1}],\"ClearPortraits\":[\"#\",\"^SET_PORTRAIT_LEFT:None\",\"/#\",\"#\",\"^SET_PORTRAIT_RIGHT:None\",\"/#\",{\"#f\":1}],\"S\":[{\"temp=\":\"emotion\"},{\"temp=\":\"char\"},\"ev\",{\"VAR?\":\"char\"},{\"VAR?\":\"Deya\"},\"?\",\"/ev\",[{\"->\":\".^.b\",\"c\":true},{\"b\":[\"\\n\",\"#\",\"^SET_PORTRAIT_LEFT:\",\"ev\",{\"VAR?\":\"char\"},\"out\",\"/ev\",\"^/\",\"ev\",{\"VAR?\":\"emotion\"},\"out\",\"/ev\",\"^.png^\",\"ev\",{\"VAR?\":\"char\"},\"out\",\"/ev\",\"^ \",\"/#\",\"#\",\"^SET_CUSTOM_LABEL:Left\",\"/#\",{\"->\":\"S.9\"},null]}],[{\"->\":\".^.b\"},{\"b\":[\"\\n\",\"#\",\"^SET_PORTRAIT_RIGHT:\",\"ev\",{\"VAR?\":\"char\"},\"out\",\"/ev\",\"^/\",\"ev\",{\"VAR?\":\"emotion\"},\"out\",\"/ev\",\"^.png^\",\"ev\",{\"VAR?\":\"char\"},\"out\",\"/ev\",\"^ \",\"/#\",\"#\",\"^SET_CUSTOM_LABEL:Right\",\"/#\",{\"->\":\"S.9\"},null]}],\"nop\",\"\\n\",{\"#f\":1}],\"B\":[{\"temp=\":\"time\"},{\"temp=\":\"zoom\"},{\"temp=\":\"target\"},\"#\",\"^SET_POS:\",\"ev\",{\"VAR?\":\"target\"},\"out\",\"/ev\",\"^ \",\"/#\",\"#\",\"^SET_CAMERA_TARGET:\",\"ev\",{\"VAR?\":\"target\"},\"out\",\"/ev\",\"^^\",\"ev\",{\"VAR?\":\"zoom\"},\"out\",\"/ev\",\"^^\",\"ev\",{\"VAR?\":\"time\"},\"out\",\"/ev\",\"/#\",{\"#f\":1}],\"SpeechBubble\":[{\"temp=\":\"chain\"},{\"temp=\":\"bubblepos\"},{\"temp=\":\"target\"},\"ev\",{\"VAR?\":\"chain\"},\"str\",\"^\",\"/str\",\"!=\",\"/ev\",[{\"->\":\".^.b\",\"c\":true},{\"b\":[\"#\",\"^SET_BUBBLEPOS:\",\"ev\",{\"VAR?\":\"target\"},\"out\",\"/ev\",\"^^\",\"ev\",{\"VAR?\":\"chain\"},\"out\",\"/ev\",{\"->\":\".^.^.^.12\"},null]}],[{\"->\":\".^.b\"},{\"b\":[\"/#\",\"#\",\"^SET_BUBBLEPOS:\",\"ev\",{\"VAR?\":\"target\"},\"out\",\"/ev\",{\"->\":\".^.^.^.12\"},null]}],\"nop\",\"/#\",\"^ \",\"#\",\"^SET_POS:\",\"ev\",{\"VAR?\":\"bubblepos\"},\"out\",\"/ev\",\"^^true \",\"/#\",\"#\",\"^SET_CUSTOM_LABEL:SpeechBubble_Talk\",\"/#\",\"\\n\",{\"#f\":1}],\"global decl\":[\"ev\",{\"list\":{},\"origins\":[\"characters\"]},{\"VAR=\":\"characters\"},{\"list\":{},\"origins\":[\"emotions\"]},{\"VAR=\":\"emotions\"},false,{\"VAR=\":\"isPlaying\"},\"/ev\",\"end\",null],\"#f\":1}],\"listDefs\":{\"characters\":{\"Deya\":1,\"Zayne\":2},\"emotions\":{\"Angry\":1,\"Neutral1\":2,\"Neutral2\":3,\"Sad\":4,\"Shock\":5,\"Smile1\":6,\"Smile2\":7,\"Smirk1\":8,\"Smirk2\":9}}}"
