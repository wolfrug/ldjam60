RawStory = "{\"inkVersion\":21,\"root\":[[[\"done\",{\"#f\":5,\"#n\":\"g-0\"}],null],\"done\",{\"init\":[[\"^Now let's change the text here and see what happens, practically speaking. It updates. All the time.\",\"\\n\",\"^Anyway. \",\"#\",\"^SET_SPRITEBACKGROUND:example_scene\",\"/#\",\"\\n\",\"^We wait a second. \",\"#\",\"^SET_SPRITESUBTEXTURE:icon^true^poi_1\",\"/#\",\"\\n\",\"ev\",\"str\",\"^Start over\",\"/str\",\"/ev\",{\"*\":\".^.c-0\",\"flg\":4},\"ev\",\"str\",\"^Play some music\",\"/str\",{\"VAR?\":\"isPlaying\"},\"!\",\"/ev\",{\"*\":\".^.c-1\",\"flg\":5},\"ev\",\"str\",\"^Stop music\",\"/str\",{\"VAR?\":\"isPlaying\"},\"/ev\",{\"*\":\".^.c-2\",\"flg\":5},\"ev\",\"str\",\"^Start Ambience\",\"/str\",\"/ev\",{\"*\":\".^.c-3\",\"flg\":4},\"ev\",\"str\",\"^Stop Ambience\",\"/str\",\"/ev\",{\"*\":\".^.c-4\",\"flg\":4},{\"c-0\":[\"\\n\",{\"->\":\"init\"},{\"#f\":5}],\"c-1\":[\"\\n\",\"^Let's play some music. \",\"#\",\"^PLAY_MUSIC:MusicCalm\",\"/#\",\"\\n\",\"ev\",true,\"/ev\",{\"VAR=\":\"isPlaying\",\"re\":true},{\"->\":\"init\"},{\"#f\":5}],\"c-2\":[\"\\n\",\"^All right, enough. \",\"#\",\"^PLAY_MUSIC:None\",\"/#\",\"\\n\",\"ev\",false,\"/ev\",{\"VAR=\":\"isPlaying\",\"re\":true},{\"->\":\"init\"},{\"#f\":5}],\"c-3\":[\"\\n\",\"#\",\"^PLAY_AMBIENCE:AmbienceWind\",\"/#\",\"^Wind wind!\",\"\\n\",{\"->\":\"init\"},{\"#f\":5}],\"c-4\":[\"\\n\",\"#\",\"^PLAY_AMBIENCE:None\",\"/#\",\"^No wind.\",\"\\n\",{\"->\":\"init\"},{\"#f\":5}]}],{\"#f\":1}],\"SpeechBubble\":[{\"temp=\":\"chain\"},{\"temp=\":\"bubblepos\"},{\"temp=\":\"target\"},\"ev\",{\"VAR?\":\"chain\"},\"str\",\"^\",\"/str\",\"!=\",\"/ev\",[{\"->\":\".^.b\",\"c\":true},{\"b\":[\"#\",\"^SET_BUBBLEPOS:\",\"ev\",{\"VAR?\":\"target\"},\"out\",\"/ev\",\"^^\",\"ev\",{\"VAR?\":\"chain\"},\"out\",\"/ev\",{\"->\":\".^.^.^.12\"},null]}],[{\"->\":\".^.b\"},{\"b\":[\"/#\",\"#\",\"^SET_BUBBLEPOS:\",\"ev\",{\"VAR?\":\"target\"},\"out\",\"/ev\",{\"->\":\".^.^.^.12\"},null]}],\"nop\",\"/#\",\"^ \",\"#\",\"^SET_POS:\",\"ev\",{\"VAR?\":\"bubblepos\"},\"out\",\"/ev\",\"^^true \",\"/#\",\"#\",\"^SET_CUSTOM_LABEL:SpeechBubble_Talk\",\"/#\",\"\\n\",{\"#f\":1}],\"global decl\":[\"ev\",false,{\"VAR=\":\"isPlaying\"},\"/ev\",\"end\",null],\"#f\":1}],\"listDefs\":{}}"
