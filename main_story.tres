[resource]
script = ExtResource("1_p6ddw")
RawStory = "{\"inkVersion\":21,\"root\":[[\"\\n\",[\"done\",{\"#f\":5,\"#n\":\"g-0\"}],null],\"done\",{\"init\":[[\"#\",\"^SET_SPRITEBACKGROUND:scene_main \",\"/#\",\"#\",\"^SET_SPRITESUBTEXTURE:city\",\"/#\",\"^The year is 2001. \",\"ev\",\"str\",\"^box_1\",\"/str\",2,5,{\"f()\":\"B\"},\"out\",\"/ev\",\"^ \",\"#\",\"^PLAY_MUSIC:MusicCalm\",\"/#\",\"\\n\",\"^It has been twenty years since the [b]War[/b] between [b]Machines[/b] and [b]Men[/b][br]and the Earth is still recovering. \",\"ev\",\"str\",\"^box_2\",\"/str\",3,1,{\"f()\":\"B\"},\"out\",\"/ev\",\"\\n\",\"^But as the [b]clouds of radiation[/b] have finally[br]started dissipating from the blasted cities... \",\"ev\",\"str\",\"^box_3\",\"/str\",2,1,{\"f()\":\"B\"},\"out\",\"/ev\",\"\\n\",\"^...[b]Scavengers[/b] - like you - have begun[br]to loot the [b]OldTek[/b] hidden in the ruins. \",\"ev\",\"str\",\"^box_4\",\"/str\",3,1,{\"f()\":\"B\"},\"out\",\"/ev\",\"\\n\",\"^There is just one problem. \",\"#\",\"^clear\",\"/#\",\"\\n\",\"^Sooo the ruin's full of robots.. \",\"ev\",{\"VAR?\":\"Deya\"},{\"VAR?\":\"Neutral2\"},{\"f()\":\"S\"},\"out\",\"/ev\",\"\\n\",\"^Your companion, Zayne, scoffs at you.\",\"\\n\",\"^So? Just don't get seen. \",\"ev\",{\"VAR?\":\"Zayne\"},{\"VAR?\":\"Neutral1\"},{\"f()\":\"S\"},\"out\",\"/ev\",\"\\n\",\"^That's easy for you to say! \",\"ev\",{\"VAR?\":\"Deya\"},{\"VAR?\":\"Angry\"},{\"f()\":\"S\"},\"out\",\"/ev\",\"\\n\",\"^Zayne is a fixer, appraiser and driver. Not a rune-delver. Yes, he's important. No, it doesn't make it any less unfair.\",\"\\n\",\"^You're not the one going in there! \",\"ev\",{\"VAR?\":\"Deya\"},{\"VAR?\":\"Angry\"},{\"f()\":\"S\"},\"out\",\"/ev\",\"\\n\",\"^Relaaax. You're faster than they are. Just don't get stuck in a corner with one. \",\"ev\",{\"VAR?\":\"Zayne\"},{\"VAR?\":\"Smile1\"},{\"f()\":\"S\"},\"out\",\"/ev\",\"\\n\",\"^If you do, they will slice you to tiny bits with their still-functioning scythe arms.\",\"\\n\",\"^Besides, they forget about you the moment they lose sight of you. So just hide. \",\"ev\",{\"VAR?\":\"Zayne\"},{\"VAR?\":\"Smirk1\"},{\"f()\":\"S\"},\"out\",\"/ev\",\"\\n\",\"^Ugh. What are we looking for anyway? \",\"ev\",{\"VAR?\":\"Deya\"},{\"VAR?\":\"Neutral1\"},{\"f()\":\"S\"},\"out\",\"/ev\",\"\\n\",\"^The old man gave us a list, but...I dunno what half of these things are. \",\"ev\",{\"VAR?\":\"Zayne\"},{\"VAR?\":\"Sad\"},{\"f()\":\"S\"},\"out\",\"/ev\",\"\\n\",\"^Let me see that. \",\"ev\",{\"VAR?\":\"Deya\"},{\"VAR?\":\"Angry\"},{\"f()\":\"S\"},\"out\",\"/ev\",\"\\n\",{\"->t->\":\"toDoList\"},\"^...well. Shit. OldTek indeed. \",\"ev\",{\"VAR?\":\"Deya\"},{\"VAR?\":\"Sad\"},{\"f()\":\"S\"},\"out\",\"/ev\",\"\\n\",\"^Let's just start looking. We'll make an educated guess once we have something. \",\"ev\",{\"VAR?\":\"Zayne\"},{\"VAR?\":\"Smirk2\"},{\"f()\":\"S\"},\"out\",\"/ev\",\"\\n\",\"^Fine. But you better pull your weight! \",\"ev\",{\"VAR?\":\"Deya\"},{\"VAR?\":\"Smirk1\"},{\"f()\":\"S\"},\"out\",\"/ev\",\"\\n\",\"ev\",{\"f()\":\"ClearPortraits\"},\"out\",\"/ev\",\"^ \",\"#\",\"^clear\",\"/#\",\"\\n\",\"^It is time to venture into the ruins and look for some OldTek! A few notes: use WASD to move. Space to interact. If you meet any nasty robots, don't let them hit you! You can't fight, but you can run. The goal is to collect all the items in the level and then leave. Good luck!\",\"\\n\",\"ev\",\"str\",\"^Load level\",\"/str\",\"/ev\",{\"*\":\".^.c-0\",\"flg\":4},{\"c-0\":[\"\\n\",\"^Loading level 1. \",\"#\",\"^LOAD_LEVEL:level_1 \",\"/#\",\"#\",\"^clear \",\"/#\",\"#\",\"^PLAY_MUSIC:MusicCombat\",\"/#\",\"\\n\",\"done\",{\"#f\":5}]}],{\"#f\":1}],\"continuePlay\":[[\"^And we're back!\",\"\\n\",\"^Hooray!\",\"\\n\",\"ev\",\"str\",\"^Back to start\",\"/str\",\"/ev\",{\"*\":\".^.c-0\",\"flg\":4},{\"c-0\":[\"\\n\",{\"->\":\"init\"},{\"#f\":5}]}],{\"#f\":1}],\"story_knot_test\":[[\"^This is a story knot! WooooOOoo! \",\"#\",\"^SET_CAMERA_TARGET:Default^1^0 \",\"/#\",\"#\",\"^SET_SPRITESUBTEXTURE:ruin\",\"/#\",\"\\n\",\"ev\",\"str\",\"^Rock on.\",\"/str\",\"/ev\",{\"*\":\".^.c-0\",\"flg\":4},\"ev\",\"str\",\"^WOOOO\",\"/str\",\"/ev\",{\"*\":\".^.c-1\",\"flg\":4},{\"c-0\":[\"\\n\",\"^We rock on.\",\"\\n\",{\"->\":\".^.^.g-0\"},{\"#f\":5}],\"c-1\":[\"\\n\",\"^Woo. \",\"#\",\"^continue\",\"/#\",\"\\n\",{\"->\":\".^.^.g-0\"},{\"#f\":5}],\"g-0\":[\"#\",\"^UNPAUSE_LEVEL \",\"/#\",\"#\",\"^continue \",\"/#\",\"#\",\"^SET_SPRITESUBTEXTURE:ruin^false\",\"/#\",\"done\",{\"#f\":5}]}],{\"#f\":1}],\"toDoList\":[\"#\",\"^ToDoList^true \",\"/#\",\"#\",\"^clear\",\"/#\",\"^To do:[br][br]\",\"#\",\"^List\",\"/#\",\"\\n\",\"<>\",\"^Collect 1 x Flip Phone.[br] \",\"#\",\"^List\",\"/#\",\"\\n\",\"<>\",\"^Collect 1 x Walkman.[br] \",\"#\",\"^List\",\"/#\",\"\\n\",\"<>\",\"^Collect 2 x Floppy Disks.[br] \",\"#\",\"^List\",\"/#\",\"\\n\",\"<>\",\"^Collect 1 x Joystick.[br][br] \",\"#\",\"^List\",\"/#\",\"\\n\",\"<>\",\"^Thank you![br] \",\"#\",\"^List\",\"/#\",\"\\n\",\"<>\",\"^Your benefactor,[br]The Collector \",\"#\",\"^List\",\"/#\",\"\\n\",\"#\",\"^ToDoList^false\",\"/#\",\"ev\",\"void\",\"/ev\",\"->->\",{\"#f\":1}],\"Pickup\":[{\"temp=\":\"amount\"},{\"temp=\":\"id\"},\"ev\",{\"VAR?\":\"pickup\"},{\"VAR?\":\"amount\"},\"+\",{\"VAR=\":\"pickup\",\"re\":true},\"/ev\",\"^We received \",\"ev\",{\"VAR?\":\"id\"},\"out\",\"/ev\",\"^ and \",\"ev\",{\"VAR?\":\"amount\"},\"out\",\"/ev\",\"^, pickup is now: \",\"ev\",{\"VAR?\":\"pickup\"},\"out\",\"/ev\",\"\\n\",\"ev\",\"str\",\"^Rad\",\"/str\",\"/ev\",\"~ret\",{\"#f\":1}],\"ClearPortraits\":[\"#\",\"^SET_PORTRAIT_LEFT:None\",\"/#\",\"#\",\"^SET_PORTRAIT_RIGHT:None\",\"/#\",{\"#f\":1}],\"S\":[{\"temp=\":\"emotion\"},{\"temp=\":\"char\"},\"ev\",{\"VAR?\":\"char\"},{\"VAR?\":\"Deya\"},\"?\",\"/ev\",[{\"->\":\".^.b\",\"c\":true},{\"b\":[\"\\n\",\"#\",\"^SET_PORTRAIT_LEFT:\",\"ev\",{\"VAR?\":\"char\"},\"out\",\"/ev\",\"^/\",\"ev\",{\"VAR?\":\"emotion\"},\"out\",\"/ev\",\"^.png^\",\"ev\",{\"VAR?\":\"char\"},\"out\",\"/ev\",\"^ \",\"/#\",\"#\",\"^SET_CUSTOM_LABEL:Left\",\"/#\",{\"->\":\"S.9\"},null]}],[{\"->\":\".^.b\"},{\"b\":[\"\\n\",\"#\",\"^SET_PORTRAIT_RIGHT:\",\"ev\",{\"VAR?\":\"char\"},\"out\",\"/ev\",\"^/\",\"ev\",{\"VAR?\":\"emotion\"},\"out\",\"/ev\",\"^.png^\",\"ev\",{\"VAR?\":\"char\"},\"out\",\"/ev\",\"^ \",\"/#\",\"#\",\"^SET_CUSTOM_LABEL:Right\",\"/#\",{\"->\":\"S.9\"},null]}],\"nop\",\"\\n\",{\"#f\":1}],\"B\":[{\"temp=\":\"time\"},{\"temp=\":\"zoom\"},{\"temp=\":\"target\"},\"#\",\"^SET_POS:\",\"ev\",{\"VAR?\":\"target\"},\"out\",\"/ev\",\"^ \",\"/#\",\"#\",\"^SET_CAMERA_TARGET:\",\"ev\",{\"VAR?\":\"target\"},\"out\",\"/ev\",\"^^\",\"ev\",{\"VAR?\":\"zoom\"},\"out\",\"/ev\",\"^^\",\"ev\",{\"VAR?\":\"time\"},\"out\",\"/ev\",\"/#\",{\"#f\":1}],\"SpeechBubble\":[{\"temp=\":\"chain\"},{\"temp=\":\"bubblepos\"},{\"temp=\":\"target\"},\"ev\",{\"VAR?\":\"chain\"},\"str\",\"^\",\"/str\",\"!=\",\"/ev\",[{\"->\":\".^.b\",\"c\":true},{\"b\":[\"#\",\"^SET_BUBBLEPOS:\",\"ev\",{\"VAR?\":\"target\"},\"out\",\"/ev\",\"^^\",\"ev\",{\"VAR?\":\"chain\"},\"out\",\"/ev\",{\"->\":\".^.^.^.12\"},null]}],[{\"->\":\".^.b\"},{\"b\":[\"/#\",\"#\",\"^SET_BUBBLEPOS:\",\"ev\",{\"VAR?\":\"target\"},\"out\",\"/ev\",{\"->\":\".^.^.^.12\"},null]}],\"nop\",\"/#\",\"^ \",\"#\",\"^SET_POS:\",\"ev\",{\"VAR?\":\"bubblepos\"},\"out\",\"/ev\",\"^^true \",\"/#\",\"#\",\"^SET_CUSTOM_LABEL:SpeechBubble_Talk\",\"/#\",\"\\n\",{\"#f\":1}],\"global decl\":[\"ev\",{\"list\":{},\"origins\":[\"characters\"]},{\"VAR=\":\"characters\"},{\"list\":{},\"origins\":[\"emotions\"]},{\"VAR=\":\"emotions\"},{\"list\":{},\"origins\":[\"oldTek\"]},{\"VAR=\":\"oldTek\"},0,{\"VAR=\":\"pickup\"},false,{\"VAR=\":\"isPlaying\"},\"/ev\",\"end\",null],\"#f\":1}],\"listDefs\":{\"characters\":{\"Deya\":1,\"Zayne\":2},\"emotions\":{\"Angry\":1,\"Neutral1\":2,\"Neutral2\":3,\"Sad\":4,\"Shock\":5,\"Smile1\":6,\"Smile2\":7,\"Smirk1\":8,\"Smirk2\":9},\"oldTek\":{\"FlipPhone\":1,\"IPod\":2,\"Walkman\":3,\"CDPlayer\":4,\"Camera\":5,\"CellPhone\":6,\"BoomBox\":7